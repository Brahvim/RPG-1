{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"args": [],
			"MIMode": "gdb",
			"type": "cppdbg",
			"environment": [
				{
					"value": "i",
					"name": "gpu",
				}
			],
			"setupCommands": [
				{
					"ignoreFailures": true,
					"text": "-enable-pretty-printing",
					"description": "Enable pretty-printing for gdb",
				},
				{
					"ignoreFailures": true,
					"text": "-gdb-set disassembly-flavor intel",
					"description": "Set Disassembly Flavor to Intel",
				},
			],
			"request": "launch",
			"stopAtEntry": false,
			"name": "iGPU",
			"externalConsole": false,
			"cwd": "${workspaceFolder}",
			"program": "${workspaceFolder}/Rpg1",
		},
		{
			"args": [],
			"MIMode": "gdb",
			"type": "cppdbg",
			"environment": [
				{
					"name": "gpu",
					"value": "d",
				},
				{
					"value": "1",
					"name": "__NV_PRIME_RENDER_OFFLOAD",
				},
				{
					"value": "nvidia",
					"name": "__GLX_VENDOR_LIBRARY_NAME",
				},
			],
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true,
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true,
				},
			],
			"request": "launch",
			"stopAtEntry": false,
			"name": "dGPU",
			"externalConsole": false,
			"cwd": "${workspaceFolder}",
			"program": "${workspaceFolder}/Rpg1",
		},
		{
			"args": [ // Not passed to Vally :/
				// "-s",
				// "--leak-check=full",
				// "--track-origins=yes",
				// "--trace-children=yes",
			],
			"MIMode": "gdb",
			"type": "cppdbg",
			"environment": [
				{
					"name": "PATH",
					"value": "$PATH:${command:cmake.launchTargetDirectory}",
				},
			],
			"setupCommands": [
				{
					"ignoreFailures": true,
					"text": "-enable-pretty-printing",
					"description": "Enable pretty-printing for gdb",
				},
				{
					"ignoreFailures": true,
					"description": "Connect to valgrind",
					"text": "${command:valgrind-task-integration.valgrindGdbArg}",
				},
			],
			"name": "Valgrind!",
			"request": "launch",
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}",
			"program": "${command:cmake.launchTargetPath}",
		},
	],
}