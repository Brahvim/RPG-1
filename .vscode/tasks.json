{
    "version": "2.0.0",
    "tasks": [
        {
            "valgrind": {
                "args": [
                    "-v",
                    "--leak-check=full",
                    "--track-origins=yes",
                ],
            },
            "problemMatcher": [
                "$valgrind-debug",
            ],
            "type": "valgrind-debug",
            "label": "valgrind-debug: valgrind-debug",
            "target": "${command:cmake.launchTargetPath}",
        },
    ],
}